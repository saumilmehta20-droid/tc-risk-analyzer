# AI provider key. A key starting with gsk_ is treated as Groq.
# Without a key the app runs in built-in demo (keyword) mode.
OPENAI_API_KEY=your_groq_or_openai_api_key_here

# Model used when the key is a Groq (gsk_) key.
GROQ_MODEL=openai/gpt-oss-120b

# Falling back to OpenAI with a non-Groq key:
# OPENAI_MODEL=gpt-4o

PORT=3000